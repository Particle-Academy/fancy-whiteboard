{
  "name": "@particle-academy/fancy-whiteboard",
  "version": "0.1.3",
  "description": "Collaborative whiteboard React components — sticky notes, diagramming, freeform drawing, presence cursors. Transport-agnostic (controlled state).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-whiteboard.git"
  },
  "homepage": "https://github.com/Particle-Academy/fancy-whiteboard#readme",
  "bugs": "https://github.com/Particle-Academy/fancy-whiteboard/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "react",
    "whiteboard",
    "collaboration",
    "sticky-notes",
    "diagramming",
    "fancy"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ]
}
